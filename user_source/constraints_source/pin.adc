# HX4S20 manual p17: dedicated user Flash, NOT the FPGA configuration Flash.
# Flash DO -> FPGA MISO; Flash DI <- FPGA MOSI. SPI mode 0 idle outputs.
set_pin_assignment { flash_cs_n }   { LOCATION = P8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { flash_miso }   { LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { flash_mosi }   { LOCATION = P7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_sclk }   { LOCATION = M9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { flash_wp_n }   { LOCATION = P9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { flash_hold_n } { LOCATION = R9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# Board LED1..LED4, active high (lesson 05 top.adc, board-verified).
set_pin_assignment { led[0] } { LOCATION = A4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[1] } { LOCATION = A3;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[2] } { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { led[3] } { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# 蜂鸣器 BUZZER（手册第 17~18 页，低电平响；SW5 拨上断开）
set_pin_assignment { buzzer } { LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
# INMP441 麦克风，J1 扩展口（手册第 12~13 页）：29 = 3.3V 接 VDD，30 = GND 接 GND 与 L/R；
# 31 GPIOA_26 = SCK、32 GPIOA_27 = WS、33 GPIOA_28 = SD（右半帧高阻，内部下拉）
set_pin_assignment { mic_sck } { LOCATION = M15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { mic_ws }  { LOCATION = L16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { mic_sd }  { LOCATION = N16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
# VS1838B 红外接收模块，5V 供电：J1 11 = VCC、12 = GND；OUT 不可直连（5V），经 10k/20k 分压或串肖特基二极管
# （正极接 FPGA）接 J1 34 = GPIOA_29 = N14。内部上拉：两种接法空闲都为高电平。
set_pin_assignment { ir_rx }   { LOCATION = N14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

